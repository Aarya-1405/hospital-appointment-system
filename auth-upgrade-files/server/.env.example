# Copy this file to ".env" (same folder) and adjust if needed.
PORT=5000
# Local MongoDB (default for MongoDB Community Server on Windows):
MONGO_URI=mongodb://127.0.0.1:27017/hospital_appointments
# MongoDB Atlas example (replace with your own connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hospital_appointments

# Secret used to sign login tokens. Use any long random text. Never share it or commit it.
JWT_SECRET=change-this-to-a-long-random-text-for-your-laptop
# How long a login lasts
JWT_EXPIRES=1d
